{
  "name": "@esta/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=$ESTA_AGENT_ENV_FILE --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "golden:ask": "node --import tsx test/golden/ask-cases.ts && node --import tsx test/golden/ask-web-cases.ts && node --import tsx test/golden/rekey-ask.ts",
    "golden:ask-fixture": "node --import tsx test/golden/ask-fixture.ts",
    "golden:watch": "node --import tsx test/golden/watch-recording.ts",
    "golden:weekly": "node --import tsx test/golden/weekly-recording.ts",
    "golden:weekly-fixture": "node --import tsx test/golden/weekly-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@anthropic-ai/sdk": "^1.4.0",
    "@esta/core": "workspace:*",
    "@esta/db": "workspace:*",
    "@esta/ops": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.118.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
