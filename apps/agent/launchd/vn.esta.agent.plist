<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>vn.esta.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd __REPO__ &amp;&amp; exec /usr/bin/caffeinate -s pnpm --filter @esta/agent start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ESTA_AGENT_ENV_FILE</key>
    <string>__ENV_FILE__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/esta-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/esta-agent.log</string>
</dict>
</plist>
