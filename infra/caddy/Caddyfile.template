{
	admin off
	auto_https off
	skip_install_trust
	ocsp_stapling off
}

(lan) {
	bind {{LAN}}
	tls "{{CERT_FILE}}" "{{KEY_FILE}}"
}

https://{{LAN}}:{{WEB_LAN_PORT}} {
	import lan
	handle /esta-dev-ca.crt {
		root * "{{PUBLIC_DIR}}"
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:{{WEB_PORT}}
	}
}

https://{{LAN}}:{{API_LAN_PORT}} {
	import lan
	@public path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/*
	handle @public {
		reverse_proxy 127.0.0.1:{{API_PORT}}
	}
	handle {
		respond 404
	}
}

https://{{LAN}}:{{INBUCKET_LAN_PORT}} {
	import lan
	reverse_proxy 127.0.0.1:{{INBUCKET_PORT}}
}
