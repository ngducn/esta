{
  "name": "esta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/web.ts dev",
    "dev:lan": "node scripts/dev-lan.ts",
    "build": "pnpm --filter @esta/web build",
    "start": "node scripts/web.ts start",
    "check": "pnpm i18n:parity && pnpm plan:coverage --quiet && pnpm tokens:check && pnpm glyphs:check && pnpm contrast:check && pnpm -r --include-workspace-root run typecheck && pnpm lint && pnpm -r --include-workspace-root run test",
    "i18n:parity": "node scripts/i18n-parity.ts",
    "plan:coverage": "node scripts/plan-coverage.ts",
    "tokens:build": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "glyphs:check": "node scripts/glyphs-check.mjs",
    "contrast:check": "tsx scripts/contrast-check.ts",
    "fonts:build": "scripts/fonts-build.sh",
    "icons:build": "node scripts/app-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run scripts eslint-rules supabase/seed/generator --exclude 'supabase/.slots/**' --exclude '**/*.live.test.ts'",
    "test:live": "vitest run scripts/web.live.test.ts",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "check:build-env": "scripts/check-build-env.sh",
    "design:detect": ".claude/skills/impeccable/scripts/impeccable detect --json apps/web/src",
    "db:start": "node scripts/db.ts start",
    "db:stop": "node scripts/db.ts stop",
    "db:status": "node scripts/db.ts status",
    "db:reset": "node scripts/db.ts reset",
    "db:reset:northstar": "node scripts/db.ts reset --variant northstar",
    "db:checksum": "node scripts/db-checksum.ts",
    "db:seed:check": "node scripts/seed-determinism.ts",
    "db:types": "node scripts/db.ts types",
    "db:test": "node scripts/db.ts test",
    "clock:set": "tsx scripts/clock-set.ts",
    "reference:build": "node scripts/reference/build-csvs.ts && node scripts/reference/build-migration.ts",
    "cron:run": "node scripts/cron-run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.5"
  }
}
