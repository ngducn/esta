{
  "name": "esta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/web.ts dev",
    "dev:lan": "node scripts/dev-lan.ts",
    "agent:dev": "node --import tsx scripts/agent-dev.ts",
    "agent:record": "node --import tsx scripts/agent-record.ts",
    "connector": "node --import tsx scripts/connector.ts",
    "connector:login": "node --import tsx scripts/connector.ts login",
    "build": "pnpm --filter @esta/web build",
    "start": "node scripts/web.ts start",
    "check": "pnpm i18n:parity && pnpm plan:coverage --quiet && pnpm seed:coverage && pnpm quality && pnpm tokens:check && pnpm glyphs:check && pnpm contrast:check && pnpm -r --include-workspace-root run typecheck && pnpm lint && pnpm -r --include-workspace-root run test",
    "quality": "node scripts/quality/main.ts",
    "verify:tier": "node scripts/verify-tier.ts",
    "i18n:parity": "node scripts/i18n-parity.ts",
    "plan:coverage": "node scripts/plan-coverage.ts",
    "phase:check": "node scripts/phase-exit.ts",
    "tokens:build": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "glyphs:check": "node scripts/glyphs-check.mjs",
    "contrast:check": "tsx scripts/contrast-check.ts",
    "fonts:build": "scripts/fonts-build.sh",
    "icons:build": "node scripts/app-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run scripts eslint-rules supabase/seed/generator fixtures/certificates/generator fixtures/statements --exclude 'supabase/.slots/**' --exclude 'supabase/seed/generator/test/**' --exclude '**/*.live.test.ts'",
    "test:live": "vitest run scripts/web.live.test.ts",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "e2e:northstar": "node scripts/db.ts reset --variant northstar && ESTA_NORTHSTAR=1 playwright test e2e/northstar.spec.ts",
    "check:build-env": "scripts/check-build-env.sh",
    "design:detect": ".claude/skills/impeccable/scripts/impeccable detect --json apps/web/src",
    "db:start": "node scripts/db.ts start",
    "db:stop": "node scripts/db.ts stop",
    "db:status": "node scripts/db.ts status",
    "db:reset": "node scripts/db.ts reset",
    "db:reset:northstar": "node scripts/db.ts reset --variant northstar",
    "db:checksum": "node scripts/db-checksum.ts",
    "db:seed:check": "node scripts/seed-determinism.ts",
    "seed:coverage": "tsx scripts/seed-coverage.ts",
    "seed:facts": "vitest run supabase/seed/generator/test --exclude 'supabase/.slots/**'",
    "db:types": "node scripts/db.ts types",
    "db:test": "node scripts/db.ts test",
    "clock:set": "tsx scripts/clock-set.ts",
    "qr:decode": "tsx scripts/decode-qr.ts",
    "gate:vietqr": "tsx scripts/gate-vietqr.ts",
    "reference:build": "node scripts/reference/build-csvs.ts && node scripts/reference/build-migration.ts",
    "cron:run": "node scripts/cron-run.ts",
    "fixtures:certificates": "tsx fixtures/certificates/generator/generate.ts",
    "fixtures:connector-demo": "tsx fixtures/connector-demo/generate.ts",
    "extraction:eval": "tsx scripts/extraction-eval.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@napi-rs/canvas": "1.0.11",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "jpeg-js": "0.4.4",
    "jscpd": "5.4.1",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "read-excel-file": "9.3.10",
    "satori": "0.35.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.5"
  }
}
