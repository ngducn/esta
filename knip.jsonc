{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip reads package.json scripts, vitest, Playwright and Next's file routes for entries. Each entry below is a file only a
  // string, a config or a shell script names, so knip cannot see it is run.
  "workspaces": {
    ".": {
      // Scripts run through `pnpm <name>`, node, or tools/ci; the statements fixture generator is run by hand (the other two are `fixtures:*` scripts); `e2e/warm-routes.ts` is Playwright globalSetup, named by a string in a ternary in playwright.config.ts; Playwright specs are found by knip's own plugin.
      "entry": ["scripts/*.ts", "scripts/**/*.test.ts", "eslint-rules/*.mjs", "fixtures/statements/generate.ts", "e2e/warm-routes.ts"],
      "project": ["scripts/**/*.ts", "eslint-rules/**", "e2e/**/*.ts", "fixtures/**/*.ts"]
    },
    "apps/connector": {
      // main.ts and the two CLI entries are chosen by name in scripts/connector.ts (`login`, `logout`).
      "entry": ["src/main.ts", "src/cli-login.ts", "src/cli-logout.ts"]
    },
    "packages/core": {
      // Stryker loads this config by the path in stryker.config.json.
      "entry": ["vitest.mutation.config.ts"]
    },
    "apps/web": {},
    "apps/agent": {},
    "packages/db": {},
    "packages/ops": {}
  }
}
